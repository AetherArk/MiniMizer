{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MiniMizer config 1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "description": "JSON interface version; independent of protocol."
    },
    "protocol": {
      "const": "0.1",
      "description": "Scientific minimization protocol."
    },
    "heme_pdb_names": {
      "type": "object",
      "description": "Input heme PDB name to prepared atom name.",
      "propertyNames": {
        "minLength": 1,
        "maxLength": 4
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4
      }
    },
    "source_smiles": {
      "type": "string",
      "description": "Authoritative ligand SMILES, including state/stereochemistry.",
      "minLength": 1
    },
    "mapping": {
      "type": "object",
      "properties": {
        "package_graphs": {
          "type": "object",
          "properties": {
            "L": {
              "type": "object",
              "properties": {
                "exact_source_smiles": {
                  "type": "string",
                  "description": "Must match authoritative ligand state.",
                  "minLength": 1
                },
                "atoms": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "properties": {
                      "source_graph_atom_index": {
                        "type": "integer",
                        "description": "Zero-based source SMILES atom index.",
                        "minimum": 0
                      },
                      "package_atom_name": {
                        "type": "string",
                        "description": "Ligand PDB atom name.",
                        "minLength": 1,
                        "maxLength": 4
                      },
                      "package_serial": {
                        "type": "integer",
                        "description": "Ligand PDB serial.",
                        "minimum": 1
                      },
                      "element": {
                        "type": "string",
                        "description": "Element symbol.",
                        "pattern": "^[A-Z][a-z]?$"
                      },
                      "formal_charge": {
                        "type": "integer",
                        "description": "Atom formal charge, elementary charges."
                      },
                      "explicit_H": {
                        "type": "integer",
                        "description": "Explicit hydrogen count.",
                        "minimum": 0
                      },
                      "implicit_H": {
                        "type": "integer",
                        "description": "Implicit hydrogen count.",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "source_graph_atom_index",
                      "package_atom_name",
                      "package_serial",
                      "element",
                      "formal_charge",
                      "explicit_H",
                      "implicit_H"
                    ],
                    "additionalProperties": false
                  },
                  "description": "Ligand heavy atoms in source graph order."
                }
              },
              "required": [
                "exact_source_smiles",
                "atoms"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "L"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "package_graphs"
      ],
      "additionalProperties": false
    },
    "ligand_state": {
      "type": "object",
      "properties": {
        "source_formal_charge": {
          "type": "integer",
          "description": "Ligand net formal charge, elementary charges."
        },
        "H_count": {
          "type": "integer",
          "description": "Total ligand hydrogens.",
          "minimum": 0
        },
        "atom_count": {
          "type": "integer",
          "description": "Total ligand atoms including hydrogens.",
          "minimum": 1
        }
      },
      "required": [
        "source_formal_charge",
        "H_count",
        "atom_count"
      ],
      "additionalProperties": false
    },
    "fixed_ligand_source_indices": {
      "type": "array",
      "items": {
        "type": "integer",
        "description": "Zero-based source atom index.",
        "minimum": 0
      },
      "uniqueItems": true,
      "description": "Ligand atoms held fixed in both stages."
    }
  },
  "required": [
    "schema_version",
    "protocol",
    "heme_pdb_names",
    "source_smiles",
    "mapping",
    "ligand_state",
    "fixed_ligand_source_indices"
  ],
  "additionalProperties": false
}
